# atriz-robot.service
#
# Levanta el robot al arrancar: driver del RVR, LIDAR, robot_state_publisher y
# collision_monitor. NO levanta SLAM, Nav2 ni localización — esos van en sus
# propios launch, a propósito (ver CLAUDE.md, decisiones tomadas).
#
# Lo instala fase_7_systemd.sh. No copiarlo a mano.
#
# ✅ VERIFICADO el 2026-07-31 con un reinicio real: el robot volvió solo,
#    ExecStartPost en status=0/SUCCESS, /scan a 0.00 Hz y /odom a 16.49.
#
# 📝 Sin ejercitar: `Restart=always` (no se ha matado el proceso para ver si
#    vuelve). Y ojo: NO arregla el fallo típico de este robot — el RVR dormido
#    deja el proceso VIVO, de eso se encarga el keepalive del driver.

[Unit]
Description=Atriz — robot RVR (driver, LIDAR, TF, collision_monitor)
Documentation=file:///home/sphero/atriz_migracion/02_manual/MANUAL_ATRIZ_ROS2.md
# El robot no necesita red para funcionar, pero rosbridge y el DDS sí, y el
# hostname tiene que estar ya fijado (lo hace atriz-first-boot.service).
After=network-online.target atriz-first-boot.service
Wants=network-online.target
# Los puertos los espera el propio script, no systemd: udev puede crear el enlace
# después de que la unidad arranque, y un After=dev-*.device no cubre ese caso.

# Si falla cinco veces en cinco minutos, para de intentarlo: un bucle de reinicio
# esconde la causa y machaca el journal. 🔴 Van en [Unit], no en [Service]:
# systemd los ignora ahí sin dar error.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# ── Los ajustes compartidos ──────────────────────────────────────────────────
# 🔴 El `-` delante NO es decorativo: sin él, la unidad NO ARRANCA si el fichero
#    falta. Con él, arranca con los valores por defecto de sus envoltorios — que
#    es lo correcto: un ajuste ausente no debe dejar el robot muerto.
# 📌 Existe porque la ruta del mapa vivía en dos sitios y se desincronizaron de
#    verdad el 2026-08-07 (evidencia 80). Aquí lo lee `supervisor_navegacion`,
#    que corre dentro de esta unidad: sin esta línea miraría un mapa distinto
#    del que usa `atriz-nav.service`, y la web pintaría el botón al revés.
EnvironmentFile=-/etc/default/atriz
Type=simple
User=sphero
Group=sphero
# Los dos puertos serie viven en el grupo `dialout`.
SupplementaryGroups=dialout
WorkingDirectory=/home/sphero

ExecStart=/usr/local/bin/atriz-robot.sh

# ── Arrancar con el LIDAR EN REPOSO ───────────────────────────────────────────
# 🔴 Sin esto el X2 giraría a 11.8 Hz de forma permanente, 24/7, en los 16
# robots, se usen o no. Hoy se queda a 2.7 Hz solo porque no hay nada corriendo;
# el arranque automático se lo cargaría sin que nadie lo decidiera.
# Medido el 2026-07-31: 11.8 vs 2.7 Hz (manual, cap. 8.4a).
#
# La seguridad encaja sola: sin /scan el collision_monitor no deja conducir, así
# que un robot en reposo no puede moverse por accidente.
#
# `-` al principio: si falla, NO tumba el servicio. Un robot escaneando de más es
# un problema de desgaste; un robot que no arranca es un problema de laboratorio.
ExecStartPost=-/usr/local/bin/atriz-escaneo off

# ── El vigía de DDS: contra el robot MUDO del arranque en frío ───────────────
# 🔴 Evidencia 109: el stack puede nacer mudo en DDS —driver vivo, RVR
# hablando, ni un mensaje cruzando en la propia Pi— con las esperas de red y
# reloj CUMPLIDAS. Intermitente (2 de 3 arranques fríos), causa sin conocer,
# remedio medido 2 de 2: reiniciar con el reloj ya bueno.
#
# El vigía espera un mensaje de /estado_robot (hasta 90 s); si no llega, deja
# una marca en /run/atriz y manda SIGINT al proceso principal — Restart=always
# hace el resto. UNA sola vez por arranque: si tras la cura sigue mudo, falla
# ABIERTO (lo deja corriendo y lo grita al journal). Un robot mudo es malo; uno
# latcheado por su propio vigía es peor.
#
# `-` al principio: un vigía roto no debe tumbar un robot sano.
ExecStartPost=-/usr/local/bin/atriz-vigia-dds

# La marca del vigía tiene que SOBREVIVIR al reinicio de la unidad (es lo que
# garantiza «una sola vez») y morir sola al reiniciar la Pi: /run/atriz con
# Preserve hace exactamente eso, y pertenece a `sphero` (User=).
RuntimeDirectory=atriz
RuntimeDirectoryPreserve=yes

# 🔴 El arranque puede ser LARGO y el tope por defecto son 90 s: el envoltorio
# espera hasta 60 s a que udev cree los puertos (y hasta 90 s al reloj), el
# launch tarda ~10 s, el ExecStartPost del barrido espera hasta 30 s a
# /stop_scan, y el vigía de DDS hasta 90 s a /estado_robot. Sumado se pasa, y
# systemd mataría un arranque que iba bien. (Era 180 hasta el 2026-08-14;
# subió al añadir el vigía.)
TimeoutStartSec=300

# ── Apagado ──────────────────────────────────────────────────────────────────
# 🔴 SIGINT, no SIGTERM. El driver apaga los LEDs y —esto importa— el LED del
# sensor de color en su manejador de SIGINT. Con SIGTERM el proceso muere sin
# ejecutarlo y el robot se queda con una luz blanca encendida bajo el chasis
# gastando batería, que ya pasó una vez.
KillSignal=SIGINT
KillMode=mixed
# El apagado limpio habla con el RVR por el puerto serie: dale margen.
TimeoutStopSec=30

# ── Reinicio ─────────────────────────────────────────────────────────────────
# ⚠️ Restart NO arregla el fallo típico de este robot: cuando el RVR se dormía,
# el proceso seguía VIVO y mudo (CLAUDE.md). De eso se encarga el keepalive del
# driver. Esto cubre las caídas de verdad.
Restart=always
RestartSec=15
# 📝 El límite de reintentos NO va aquí: `StartLimitIntervalSec` y
# `StartLimitBurst` viven en [Unit]. Están arriba.
# 🔴 Y NO te fíes de `systemd-analyze verify` para pillarlo. Medido en systemd
#    255 el 2026-08-03, poniéndolos en [Service] a propósito:
#      StartLimitIntervalSec -> «Unknown key name … in section 'Service',
#                                ignoring»   ✅ lo dice
#      StartLimitBurst       -> ni una línea  🔴 NO lo dice
#    (control: una directiva inventada sí la detecta, o sea que el verificador
#     funciona; es que `StartLimitBurst` lo acepta en [Service] sin quejarse.)
#    Una versión anterior de esta nota decía que el verificador cogía los dos.
#    Era falso, y es justo la clase de error que este fichero existe para evitar.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=atriz-robot

[Install]
WantedBy=multi-user.target
