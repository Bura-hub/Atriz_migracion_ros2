# atriz-nav.service
#
# Levanta la NAVEGACIÓN: AMCL (localizacion.launch.py) + Nav2 (nav2.launch.py).
#
# 🔴 SE INSTALA PERO **NO SE HABILITA**. Tras un reinicio vuelve el driver y NO
#    vuelve la navegación — decisión del usuario, 2026-08-03. El bloque
#    [Install] existe para que `systemctl enable atriz-nav` funcione el día que
#    la web lo pida, que es todo el punto del diseño:
#    03_operacion/ARRANQUE_NAVEGACION.md
#
#    El porqué, en una línea: Nav2 cuesta ~58 % de un núcleo y la Pi se alimenta
#    del USB del RVR, así que sale de la batería del robot — y la autonomía
#    (~2 h) ya no cubre una clase (2-3 h).
#
# Lo instala fase_7_systemd.sh. No copiarlo a mano.
#
# 📝 NO VERIFICADO — escrito el 2026-08-03, sin haberse arrancado nunca bajo
#    systemd. Lo verifica la tarea 4 del plan, que exige el mapa del aula.

[Unit]
Description=Atriz — navegación (AMCL + Nav2)
Documentation=file:///home/sphero/atriz_migracion/03_operacion/ARRANQUE_NAVEGACION.md

# 🔴 BindsTo, no solo After. Si el driver se para, la navegación se para con él:
#    un Nav2 publicando sobre una odometría muerta es algo que parece vivo y no
#    lo está — lo mismo que `on_exit=Shutdown()` vino a resolver en
#    robot.launch.py.
# ── PartOf, NO BindsTo. CAMBIADO el 2026-08-07, y está MEDIDO ────────────────
# Aquí ponía `BindsTo=atriz-robot.service`, y el razonamiento era correcto pero
# incompleto: `BindsTo=` propaga la PARADA, no el REINICIO. El driver se
# reinicia solo de forma rutinaria, así que a mitad de clase un nodo muere, el
# driver se repone, y **la navegación desaparece sin que nadie la haya parado**.
#
#   medido el 2026-08-07 matando el proceso base, con el PID como testigo
#   (evidencia 78, 9 de 9):
#
#     BindsTo=            -> inactive.  NO VUELVE.        🔴
#     PartOf= (+Requires) -> active CON PID NUEVO.        ✅ vuelve LIMPIA
#     las dos juntas      -> inactive: BindsTo gana.      🔴
#
# 🔴 PID nuevo = proceso nuevo = búfer TF nuevo. Sobrevivir es el fallo, no el
#    remedio: es la trampa del slam_toolbox vivo y mudo.
# ⚠️ La tabla anterior decía que `PartOf=` «deja la unidad viva y muda». Era
#    falso: registraba solo `is-active`, y `active` significa dos cosas opuestas
#    sin el timestamp que las separa.
PartOf=atriz-robot.service
Requires=atriz-robot.service
After=atriz-robot.service

# 🔴 Van en [Unit], NO en [Service]. Y ojo, porque los dos NO se comportan
#    igual — medido en systemd 255 el 2026-08-03:
#      StartLimitIntervalSec en [Service] -> «Unknown key name … ignoring»
#      StartLimitBurst       en [Service] -> systemd NO dice NADA
#    Así que `systemd-analyze verify` coge uno y **no coge el otro**. Ya mordió
#    una vez; poniéndolos aquí arriba no puede volver a morder.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=sphero
Group=sphero
WorkingDirectory=/home/sphero
# ── Los ajustes compartidos ──────────────────────────────────────────────────
# 🔴 El `-` delante NO es decorativo: sin él, la unidad NO ARRANCA si el fichero
#    falta. Con él, arranca con los valores por defecto de sus envoltorios — que
#    es lo correcto: un ajuste ausente no debe dejar el robot muerto.
# 📌 Existe porque la ruta del mapa vivía en dos sitios y se desincronizaron de
#    verdad el 2026-08-07 (evidencia 80).
EnvironmentFile=-/etc/default/atriz


# ── El barrido, ANTES de arrancar ─────────────────────────────────────────────
# 🔴 SIN `-`, a diferencia de atriz-robot.service. Allí un fallo al APAGAR el
#    barrido es desgaste; aquí un fallo al ENCENDERLO deja la navegación ciega:
#    sin /scan el collision_monitor bloquea el movimiento (medido: 0.0 cm contra
#    9.9 del control) y el robot parece averiado. Si no se puede encender, esta
#    unidad NO debe arrancar.
# 📝 `atriz-escaneo on` ya comprueba el EFECTO —espera a que /scan publique de
#    verdad— y devuelve error si no. No hace falta comprobarlo otra vez aquí.
# 🔴 LA EXCLUSIÓN VA PRIMERO, antes de encender el LIDAR. Si hay un
#    slam_toolbox vivo, esto falla en ~0,1 s y no se ha gastado un segundo de X2
#    a 11,8 Hz. Antes lo comprobaba `localizacion.launch.py`, pero DESPUÉS del
#    barrido y de ~10 s de arranque: fallaba igual, pero tarde y caro.
ExecStartPre=/usr/local/bin/atriz-exclusion nav
# 🔁 `on-recordando` desde el 2026-08-14 (decisión B del conflicto 2): anota si
#    el barrido YA estaba encendido —un alumno con atriz.py, la teleop web— y en
#    ese caso el paro lo deja como estaba. Coste: ~2 s más de arranque cuando el
#    barrido está apagado (la ventana de la comprobación previa).
ExecStartPre=/usr/local/bin/atriz-escaneo on-recordando atriz-nav.service

ExecStart=/usr/local/bin/atriz-nav.sh

# Al parar, devolver el barrido a su estado de reposo. Con `-`: si falla, no
# bloquea el apagado.
# ⚠️ Esto puede dejar sin /scan a un guion de alumno que esté corriendo en ese
#    momento. Se acepta porque parar la navegación es un acto explícito de
#    operador, no algo que ocurra solo. La dirección contraria —que el guion del
#    alumno deje ciega a la navegación— sí se arregla, en `atriz.py`.
# 🔴 `off-si-sobra`, NO `off`. El comentario de abajo justificaba el `off`
#    incondicional diciendo «parar la navegación es un acto explícito de
#    operador, no algo que ocurra solo». **Esa premisa murió con el botón de la
#    web** (decisión del usuario, 2026-08-06): ahora lo hace un alumno con un
#    clic, sobre un robot que puede estar compartido, y apagar /scan deja al
#    robot sin obedecer cmd_vel para todos los demás SIN NINGÚN ERROR.
ExecStopPost=-/usr/local/bin/atriz-escaneo off-si-sobra atriz-nav.service

# Nav2 tarda en levantar sus nodos de ciclo de vida, y el arranque incluye
# esperar a que /scan publique.
# ⏳ Cuánto tarda exactamente es una de las cosas que la tarea 4 mide por primera
#    vez: el proyecto NO lo tiene medido, y es el dato que hará falta el día que
#    haya que decidir si la navegación arranca sola.
TimeoutStartSec=120

# ── Apagado ───────────────────────────────────────────────────────────────────
# SIGINT para que los nodos de ciclo de vida de Nav2 ejecuten su apagado limpio.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=30

# ── Reinicio ──────────────────────────────────────────────────────────────────
# ⚠️ on-failure, NO always. Con `always`, una salida limpia también reiniciaría —
#    y aquí una salida con código 0 significa «alguien lo paró» o «no hay mapa».
#    Reintentar eso sería un bucle sin sentido. El StartLimit de arriba corta el
#    bucle si Nav2 se cae una y otra vez de verdad.
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=atriz-nav

[Install]
WantedBy=multi-user.target
