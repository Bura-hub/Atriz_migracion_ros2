#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
# atriz-encargo — recibe un encargo del PC y devuelve un parte con pruebas
# ═══════════════════════════════════════════════════════════════════════════════
#
#   Desde el PC (PowerShell, cmd, bash — da igual):
#
#       "Dime a qué Hz publica /odom" | ssh rvr-01 atriz-encargo
#
#   El encargo entra por STDIN. Eso NO es un capricho: el 2026-08-03 se intentó
#   pasarlo como argumento y PowerShell expandió el `$(cat …)` en el Windows del
#   usuario y se comió el paréntesis de `Bash(ros2 …)`. El entrecomillado anidado
#   PowerShell → ssh → bash → claude es infumable, y falla de formas distintas en
#   cada shell. Por stdin no hay nada que entrecomillar.
#
# POR QUÉ ESTE SCRIPT EXISTE, SI EL PLAN DECÍA «CERO CÓDIGO EN EL ROBOT»
#
#   Porque la alternativa —el comando desnudo desde el PC— se midió y no es
#   usable. Esto no es el envoltorio de confinamiento que el plan descartó (ese
#   llevaba `command=` en authorized_keys y tres anillos para mover el robot):
#   es una línea de comandos larga metida en un fichero. No abre nada, no
#   instala nada y **se va con Claude Code** cuando fase_6 lo desinstale.
#
# 🔴 NO MUEVE EL ROBOT. Lee, mide, diagnostica e informa. El movimiento va por
#    una sesión con un humano delante (`claude --remote-control`).
#    Ver 03_operacion/PC_Y_ROBOT.md.
# ═══════════════════════════════════════════════════════════════════════════════
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLAUDE="$HOME/.local/bin/claude"
HILO_FILE="$HOME/.atriz-encargo-hilo"

morir() { printf '{"hecho":false,"resumen":%s,"evidencia":[],"comandos_ejecutados":[],"no_verificado":["el encargo no llegó a ejecutarse"],"requiere_usuario":[],"machine_id":null,"uptime_s":null,"git_head":null,"git_sucio":null,"ros_domain_id":null}\n' \
          "$(printf '%s' "$1" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')"; exit 1; }

# ── El entorno de ROS ────────────────────────────────────────────────────────
# 🔴 ESTE BLOQUE SUSTITUYE AL `bash -lc`, y por eso el script se invoca a pelo.
#    Un `ssh host comando` NO lee /etc/profile.d: sin esto, ROS_DOMAIN_ID sale
#    vacío, el delegado mira el dominio DDS 0, no ve NINGÚN topic y concluye que
#    el robot está muerto — sin un solo error. Medido el 2026-08-03 desde el PC:
#      ssh rvr-01 "echo $ROS_DOMAIN_ID; command -v ros2"  ->  vacío · SIN-ros2
#    Y el `bash -lc` como argumento de ssh tiene su propia trampa (ssh une los
#    argumentos con espacios y `bash -c` solo coge la palabra siguiente), así
#    que se evita el problema entero cargando el entorno aquí dentro.
set +u
[[ -f /etc/profile.d/atriz-robot.sh ]] && . /etc/profile.d/atriz-robot.sh
[[ -f /etc/profile.d/atriz-ros.sh   ]] && . /etc/profile.d/atriz-ros.sh
set -u

# Se comprueba el EFECTO de haber cargado el entorno, no que los ficheros
# existan: si el dominio no es el del robot, cualquier conclusión sobre topics
# sería inválida, y es mejor no empezar que devolver un parte que miente.
[[ -n "${ROS_DOMAIN_ID:-}" ]] || morir "ROS_DOMAIN_ID vacío tras cargar /etc/profile.d: el delegado miraría el dominio DDS 0 y no vería ningún topic. Ejecuta: sudo bash $REPO/scripts/fase_7_systemd.sh"
command -v ros2 >/dev/null || morir "ros2 no está en el PATH tras cargar /etc/profile.d/atriz-ros.sh"
[[ -x "$CLAUDE" ]] || morir "no está $CLAUDE (¿se desinstaló Claude Code? este canal es de desarrollo)"

# ── El encargo ───────────────────────────────────────────────────────────────
if [[ $# -gt 0 ]]; then
    ENCARGO="$*"
else
    ENCARGO="$(cat)"
fi
[[ -n "${ENCARGO// /}" ]] || morir "encargo vacío. Uso:  echo 'mide los Hz de /odom' | ssh rvr-01 atriz-encargo"

# ── El ámbito del proyecto ───────────────────────────────────────────────────
# 🔴 `cd` OBLIGATORIO. El ámbito de Claude Code sale del directorio de trabajo,
#    y ~/.claude/projects/ solo tiene uno: `-home-sphero`. Arrancar desde otro
#    sitio crea un ámbito NUEVO, vacío, sin la memoria del proyecto y SIN AVISAR.
#    Un `ssh host comando` normalmente arranca en $HOME, pero eso depende del
#    servidor: aquí no se deja al azar.
cd "$HOME" || morir "no puedo entrar en $HOME"

# ── El hilo, que da memoria entre encargos ───────────────────────────────────
# --resume no cruza máquinas, pero no necesita cruzarla: la sesión vive aquí y
# se direcciona por UUID. Verificado con control el 2026-08-03 (evidencia 66).
# 📝 Es EFÍMERO: se pierde al desinstalar Claude Code. Lo que valga, se commitea.
#
# 🔴 SE COMPRUEBA QUE EL HILO EXISTE DE VERDAD, no que el fichero tenga texto.
#    La primera versión escribía el UUID ANTES de saber si la sesión llegó a
#    crearse. Una prueba interrumpida dejó un UUID cuya sesión nunca existió, y
#    a partir de ahí TODOS los encargos morían con «No conversation found with
#    session ID: …» — un canal roto para siempre por un fichero de 36 bytes.
#    Medido el 2026-08-03 desde el PC del usuario.
PROY="$HOME/.claude/projects/-home-sphero"
BASE_FILE="$HOME/.atriz-encargo-base"
HILO=""

if [[ -s "$HILO_FILE" ]]; then
    CAND="$(cat "$HILO_FILE")"
    if [[ -f "$PROY/$CAND.jsonl" ]]; then
        HILO="$CAND"; MODO_HILO=(--resume "$HILO")
    else
        # El hilo apuntaba a una sesión inexistente. No es un error del usuario
        # ni algo que deba bloquear: se empieza uno nuevo y se dice por qué.
        echo "[atriz-encargo] el hilo $CAND ya no existe; empiezo uno nuevo" >&2
        rm -f "$HILO_FILE"
    fi
fi

if [[ -z "$HILO" ]]; then
    # ── En frío, salvo que exista ~/.atriz-encargo-base ──────────────────────
    #
    # 🔴 EL DEFECTO ES ARRANCAR EN FRÍO, y es una decisión con número detrás.
    #    Se implementó que el encargo bifurcara de la sesión de trabajo, que era
    #    lo que el usuario pidió («debe apuntar exactamente a esta misma
    #    sesión»). Se midió el 2026-08-03 y se descartó:
    #
    #       en frío (CLAUDE.md + ESTADO_ACTUAL.md)   $0.95   ~30.000 tokens
    #       bifurcando la sesión de trabajo (42 MB)  $8.52   2.793.122 tokens
    #
    #    Nueve veces más caro sobre un encargo trivial, y el hilo bifurcado nace
    #    con 3.9 MB y crece. Lo que el delegado necesita no es la conversación
    #    —22.286 turnos, casi todo ruido de depuración— sino qué se ha hecho y
    #    por qué, que está en ESTADO_ACTUAL.md y se carga gratis. Esa es la
    #    razón de que ESTADO_ACTUAL.md exista.
    #
    #    Para activarlo puntualmente:
    #       echo <uuid> > ~/.atriz-encargo-base    # bifurca
    #       rm ~/.atriz-encargo-base               # vuelve a frío
    #
    #    Si se activa, se usa --fork-session y no --resume a secas: la sesión de
    #    trabajo puede estar VIVA, y sobre una en uso Claude Code responde
    #    «Session ID … is already in use» — medido. Bifurcar crea un id nuevo y
    #    deja intacta la original.
    if [[ -s "$BASE_FILE" ]]; then
        BASE="$(cat "$BASE_FILE")"
        if [[ -f "$PROY/$BASE.jsonl" ]]; then
            MODO_HILO=(--resume "$BASE" --fork-session)
            echo "[atriz-encargo] bifurcando de la sesión de trabajo $BASE ($(du -h "$PROY/$BASE.jsonl" | cut -f1))" >&2
        else
            echo "[atriz-encargo] la sesión base $BASE no existe; arranco en frío" >&2
            BASE=""
        fi
    fi
    if [[ -z "${BASE:-}" ]]; then
        HILO="$(python3 -c 'import uuid;print(uuid.uuid4())')"
        MODO_HILO=(--session-id "$HILO")
    fi
fi

# ── Lista BLANCA de herramientas ─────────────────────────────────────────────
# 🔴 Blanca y no negra. Con --disallowedTools el delegado no pudo ejecutar NADA
#    (en modo -p se deniega todo lo que pide aprobación): 20 comandos, 20
#    denegados. Es el mismo patrón que la lista blanca de rosbridge — enumerar
#    lo permitido, no adivinar lo prohibido.
# ⚠️ Aquí NO entra nada que mueva el robot, ni sudo, ni escritura fuera del repo.
PERMITIDO=(
    Read Grep Glob
    "Bash(ros2 topic hz:*)" "Bash(ros2 topic list:*)" "Bash(ros2 topic info:*)"
    "Bash(ros2 topic echo:*)" "Bash(ros2 node list:*)" "Bash(ros2 service list:*)"
    "Bash(timeout:*)" "Bash(stdbuf:*)" "Bash(printenv:*)" "Bash(date:*)"
    "Bash(hostname:*)" "Bash(uptime:*)" "Bash(uname:*)"
    "Bash(cat /etc/machine-id)" "Bash(cat /proc/uptime)"
    "Bash(git -C $REPO status:*)" "Bash(git -C $REPO rev-parse:*)" "Bash(git -C $REPO log:*)"
    "Bash(systemctl is-active:*)" "Bash(systemctl is-enabled:*)" "Bash(systemctl status:*)"
    "Bash(journalctl --user:*)" "Bash(ps:*)" "Bash(free:*)" "Bash(df:*)"
    "Bash(/usr/local/bin/atriz-escaneo estado)"
)

# ── Ejecutar ─────────────────────────────────────────────────────────────────
# 🔴 NO se usa `exec`: hay que mirar el resultado ANTES de anotar el hilo.
#    Escribir el UUID antes de saber si la sesión existe fue lo que dejó el
#    canal roto para siempre el 2026-08-03: un encargo interrumpido dejó
#    apuntado un hilo inexistente y todos los siguientes morían con
#    «No conversation found with session ID: …».
# 📝 mktemp y no una ruta fija de /tmp: con fs.protected_regular=2 ni root puede
#    sobrescribir un fichero de /tmp que no es suyo, y el script leería
#    contenido rancio creyendo que es el de ahora. Ya costó un diagnóstico.
SALIDA="$(mktemp -t atriz-encargo.XXXXXX)"
trap 'rm -f "$SALIDA"' EXIT

timeout 900 "$CLAUDE" -p "${MODO_HILO[@]}" \
    --output-format json \
    --json-schema "$(cat "$REPO/03_operacion/esquema_parte.json")" \
    --add-dir "$REPO" \
    --append-system-prompt "$(cat "$REPO/03_operacion/CONTRATO_ENCARGO.md")" \
    --allowedTools "${PERMITIDO[@]}" \
    -- "$ENCARGO" < /dev/null > "$SALIDA" 2>&1
COD=$?

# ── Anotar el hilo, solo si de verdad hay sesión ─────────────────────────────
# Se comprueba el EFECTO —que el transcripto existe en el disco— y no que el
# comando devolviera 0: `claude -p` devuelve 0 hasta cuando dice «Not logged
# in» o «Session ID already in use». Medido dos veces el 2026-08-03.
NUEVO_HILO="$(python3 - "$SALIDA" <<'PY' 2>/dev/null
import json,sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get("session_id","") if not d.get("is_error") else "")
except Exception:
    print("")
PY
)"
if [[ -n "$NUEVO_HILO" && -f "$PROY/$NUEVO_HILO.jsonl" ]]; then
    printf '%s' "$NUEVO_HILO" > "$HILO_FILE"
else
    # Sin sesión utilizable no se anota nada: el siguiente encargo volverá a
    # bifurcar de la base. Es preferible repetir el coste que dejar el canal
    # apuntando a algo que no existe.
    rm -f "$HILO_FILE"
    [[ $COD -ne 0 ]] && echo "[atriz-encargo] el encargo falló (código $COD); el hilo no se anota" >&2
fi

cat "$SALIDA"
exit $COD
